<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#0C0F14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="URL lub zapytanie Web"
            android:inputType="textUri"
            android:textColor="#E6EDF7"
            android:textColorHint="#7A8BA3" />

        <Button
            android:id="@+id/goButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GO" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/endpointInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:hint="Endpoint /v1/chat/completions"
            android:inputType="textUri"
            android:textColor="#E6EDF7"
            android:textColorHint="#7A8BA3" />

        <EditText
            android:id="@+id/modelInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Model"
            android:inputType="text"
            android:textColor="#E6EDF7"
            android:textColorHint="#7A8BA3" />

        <EditText
            android:id="@+id/apiKeyInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="API Key"
            android:inputType="textPassword"
            android:textColor="#E6EDF7"
            android:textColorHint="#7A8BA3" />
    </LinearLayout>

    <EditText
        android:id="@+id/promptInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Prompt / JSON messages"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:textColor="#E6EDF7"
        android:textColorHint="#7A8BA3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/testAiButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TEST AI" />

        <Button
            android:id="@+id/searchAndAskButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="WEB + AI" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:text="Status: INIT | Bridge: AndroidNative"
        android:textColor="#10B981"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/outputView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="8"
        android:padding="4dp"
        android:text=""
        android:textColor="#E6EDF7"
        android:textSize="12sp" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
