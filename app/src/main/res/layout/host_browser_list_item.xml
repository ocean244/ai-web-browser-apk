<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/list_column_padding">

    <ImageView
        android:id="@+id/browser_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/choose_host_browser_dialog_title"
        android:src="@drawable/last_resort_runtime_host_logo" />

    <TextView
        android:id="@+id/browser_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:textSize="@dimen/webapk_text_size_medium_dense" />
</LinearLayout>
